{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "banso-pilates",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pilates",
      "database_id": "d7d18a98-1fd9-4837-9a2e-8d92b22699c4"
    }
  ],
  // 毎日 20:00 JST（前日リマインド・完了押し忘れ）／毎月1日 9:00 JST（前月の精算額）
  "triggers": { "crons": ["0 11 * * *", "0 0 1 * *"] },
  "vars": {
    "APP_URL": "https://pilates.banso-club.com",
    "ADMIN_EMAIL": "hiroki.ito@banso-club.com"
  }
}
